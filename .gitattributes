# Normalise line endings on commit.  The original workspace was Windows MATLAB,
# so most .m files still carry CRLF; this converts them to LF in the repository
# while leaving each working copy native.
* text=auto eol=lf

*.m      text
*.c      text
*.cpp    text
*.h      text
*.hpp    text
*.md     text
*.tsv    text
*.sh     text eol=lf

# Prebuilt binaries are retained for historical compatibility. Some sources
# have since been recovered; see docs/MEX_RECOVERY.md. Never translate binaries.
*.mex*       binary
*.mexw32     binary
*.mexw64     binary
*.mexa64     binary
*.mexmaci64  binary
*.dll        binary
*.dylib      binary
*.so         binary
*.manifest   binary
*.sln        text eol=crlf
*.vcxproj    text eol=crlf
*.filters    text eol=crlf

# Keep GitHub's language statistics about *this* project rather than about the
# bundled toolboxes.
thirdparty/** linguist-vendored
iid/**        linguist-vendored

# Preserve byte-level provenance of recovered historical source archives.
legacy/** -text !eol linguist-vendored
